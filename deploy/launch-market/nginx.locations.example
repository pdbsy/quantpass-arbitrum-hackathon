# Review inside the existing approved HTTPS server block. Do not replace other routes.
# The existing access-service port 4188 is a source default, not a verified live-port setting.
location /auth/ {
    proxy_pass http://127.0.0.1:4188;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location /api/launch-market/ {
    proxy_pass http://127.0.0.1:4101;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 75s;
}

# Review routing of the approved AlphaForge UI and /assets/ to the same release.
# Cookie and Origin headers retain their normal nginx forwarding behavior.
# Do not expose the loopback /health endpoint or route other product backends here implicitly.
