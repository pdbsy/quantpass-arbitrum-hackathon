{
  "schemaVersion": 1,
  "versionSources": {
    "node": ".node-version",
    "npm": "package.json#packageManager"
  },
  "supplyPolicy": "planning/supply-chain-policy.json",
  "platforms": {
    "darwin": ["arm64"],
    "linux": ["x64"],
    "win32": ["x64"]
