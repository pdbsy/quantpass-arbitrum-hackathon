      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "verify-windows": {
      "platform": "win32",
      "arch": "x64",
      "label": "windows-2025"
    },
    "verify-macos": {
      "platform": "darwin",
      "arch": "arm64",
      "label": "macos-15"
    },
    "contracts-m3-macos": {
      "platform": "darwin",
      "arch": "arm64",
      "label": "macos-15"
    },
    "contracts-m3-linux": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "source-policy-js": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "dependency-delta-audit": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "semgrep-ce": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "osv-scanner": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "gitleaks": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    },
    "container-testnet": {
      "platform": "linux",
      "arch": "x64",
      "label": "ubuntu-24.04"
    }
  },
  "macDeveloperManager": "fnm",
  "networkProfile": "local-mock",
  "contractProfile": "inactive",
  "report": {
    "path": ".checks/environment/report.json",
    "maxBytes": 65536,
    "maxAgeSeconds": 900
  }
