{
  "schemaVersion": 3,
  "updatedAt": "2026-09-07",
  "decision": {
    "id": "ADR-0001",
    "status": "review",
    "scope": "Robinhood Chain Testnet hackathon MVP",
    "supersedes": []
  },
  "operatingModel": {
    "execution": "user-confirmed-single-intent",
    "unattendedExecution": false,
    "humanReadableWalletConfirmationPerIntent": true,
    "pendingIsSuccess": false,
    "localSimulationMayReachTestnetAdapter": false
  },
  "environment": {
    "allowed": ["local-simulation", "robinhood-chain-testnet"],
    "chainId": 46630,
    "mainnetSupported": false,
    "realFundsSupported": false,
    "writePlanes": {
      "deployment": {
        "enabled": false,
        "activation": "manual-one-time-reviewed",
        "requiresCompletedTasks": [
          "GOV-001",
          "THREAT-001",
          "CONFIG-001",
          "ASSET-001",
          "TRUST-001",
          "TOOL-001",
          "SPEC-001",
          "SPEC-002",
          "ABI-001",
          "SUPPLY-001",
          "CON-001",
          "CON-002",
          "TST-001",
          "TST-002",
          "SEC-002",
          "KEY-001",
          "DRYRUN-001"
        ],
        "requiresPassedGates": ["G1", "G2"]
      },
      "application": {
        "enabled": false,
        "activation": "explicit-reviewed-feature-flag",
        "requiresCompletedTasks": [
          "PRIV-001",
          "WALLET-001",
          "ADAPTER-001",
          "TX-001",
          "INDEX-001",
          "BACKEND-001",
          "RPC-001",
          "WEBSEC-001",
          "DEPLOY-001",
          "VERIFY-001",
          "OBS-001",
          "IR-001"
        ],
        "requiresPassedGates": ["G1", "G2", "G3"]
      }
    }
  },
  "custody": {
    "model": "protocol-contract-custody-application-non-custodial",
    "applicationHoldsUserKeys": false,
    "nonOwnerCanWithdraw": false,
    "ownerDirectExitDuringPause": true,
    "description": "测试资产只可进入用户选择的 Vault；应用、团队、签名者、执行器与暂停者不持有用户私钥且不能提取用户资产。"
  },
  "contract": {
    "upgradeability": "immutable-v1",
    "proxyAllowed": false,
    "delegatecallAllowed": false,
    "arbitraryTargetOrCalldataAllowed": false,
    "callPolicy": "typed-fixed-target-and-selector-only",
    "externalTargetUpgradeability": "reject-proxy-or-mutable-implementation",
    "approvalPolicy": "exact-amount-reset-to-zero",
    "nativeValuePolicy": "zero-only-no-native-asset",
    "externalPositionModel": "atomic-only-no-async-external-custody",
    "pauseMode": "irreversible-for-address",
    "unpauseAllowed": false,
    "migration": "owner-withdraws-to-wallet-then-explicitly-deposits-new-address"
  },
  "assetPolicy": {
    "maxAssetCountPerVault": 1,
    "selection": "immutable-at-deployment",
    "activeAllowlist": [],
    "eligibleAfterAssetReview": ["project-deployed-fixed-supply-clearly-labelled-test-token"],
    "faucetPolicy": "transfer-preallocated-test-supply-to-user-never-mint-to-vault",
    "depositAccounting": "reject-unless-balance-delta-equals-requested-amount",
    "requiredProperties": [
      "erc20-return-values-checked",
      "decimals-pinned-and-validated",
      "runtime-bytecode-hash-pinned",
      "address-and-chain-id-pinned",
      "fixed-supply",
      "no-admin-balance-mutation",
      "no-owner-admin-or-privileged-role",
      "holder-transfers-cannot-be-paused-frozen-or-gated",
      "source-bytecode-and-negative-behavior-tests-required"
    ],
    "rejectedBehaviors": [
      "fee-on-transfer",
      "rebasing",
      "erc777-or-callback-hooks",
      "unknown-or-changing-decimals",
      "unverified-runtime-bytecode",
      "hidden-transfer-tax",
      "admin-mint-to-vault",
      "confiscation-or-blacklist",
      "burn-from-vault",
      "proxy-or-mutable-implementation",
      "global-pause-or-freeze",
      "transfer-allowlist-or-gating",
      "owner-admin-or-access-control-role"
    ]
  },
  "capabilities": [
    { "id": "deposit_test_asset", "owners": ["owner"] },
    { "id": "withdraw_test_asset", "owners": ["owner"] },
    { "id": "revoke_pending_intent", "owners": ["owner"] },
    { "id": "sign_single_execution_intent", "owners": ["owner"] },
    { "id": "propose_bounded_decision", "owners": ["strategy-runtime"] },
    { "id": "sign_bounded_execution_permit", "owners": ["risk-signer"] },
    { "id": "sign_confirmed_account_snapshot", "owners": ["snapshot-signer"] },
    { "id": "irreversibly_pause_risk_increase", "owners": ["pause-guardian"] },
    { "id": "deploy_immutable_contract", "owners": ["deployer"] },
    { "id": "read_confirmed_events", "owners": ["indexer"] },
    { "id": "reconcile_state", "owners": ["indexer"] }
  ],
  "roles": [
    {
      "id": "owner",
      "authority": "wallet-signature",
      "capabilities": [
        "deposit_test_asset",
        "withdraw_test_asset",
        "revoke_pending_intent",
        "sign_single_execution_intent"
      ]
    },
    {
      "id": "strategy-runtime",
      "authority": "release-manifest-pinned-ed25519-key",
      "capabilities": ["propose_bounded_decision"]
    },
    {
      "id": "risk-signer",
      "authority": "deployment-manifest-pinned-evm-key",
      "capabilities": ["sign_bounded_execution_permit"]
    },
    {
      "id": "snapshot-signer",
      "authority": "deployment-manifest-pinned-ed25519-key",
      "capabilities": ["sign_confirmed_account_snapshot"]
    },
    {
      "id": "pause-guardian",
      "authority": "immutable-separate-guardian-address",
      "capabilities": ["irreversibly_pause_risk_increase"]
    },
    {
      "id": "deployer",
      "authority": "one-time-low-balance-deployment-account",
      "capabilities": ["deploy_immutable_contract"]
    },
    {
      "id": "indexer",
      "authority": "read-only-rpc-no-signing-key",
      "capabilities": ["read_confirmed_events", "reconcile_state"]
    }
  ],
  "roleLifecycle": {
    "zeroAddressOrKeyAllowed": false,
    "evmRoleAddressesPairwiseDistinct": ["risk-signer", "pause-guardian", "deployer"],
    "ed25519TrustKeysPairwiseDistinct": ["strategy-runtime", "snapshot-signer"],
    "crossRoleKeyMaterialReuseAllowed": false,
    "identityComparison": "canonical-address-or-public-key-fingerprint-as-applicable",
    "inPlaceRotation": false,
    "replacement": "irreversible-pause-owner-exit-new-manifest-new-contract-explicit-owner-reauthorization",
    "deployerRetainsPostDeploymentPrivilege": false
  },
  "safeExit": {
    "availableDuringPause": true,
    "riskIncreasingActionsBlocked": ["deposit", "new_execution_intent", "new_strategy_or_venue_call"],
    "ownerActionsAlwaysAllowed": ["revoke_pending_intent", "withdraw_test_asset"],
    "onlyAssetOutflowDuringPause": "vault-to-owner-withdrawal",
    "asyncExternalPositionsAllowed": false,
    "unpauseOrAdminMigrationAllowed": false
  },
  "executionConcurrency": {
    "stateVersion": "monotonic-on-chain-increment-on-every-successful-vault-state-mutation",
    "signedPrecondition": "owner-and-risk-bind-expected-state-version-and-state-hash",
    "contractEnforcement": "exact-match-then-atomic-state-change-and-increment",
    "riskServiceIssuance": "serializable-single-reservation-per-vault-and-state-version",
    "snapshotReuse": "at-most-one-execution-per-vault-state-version"
  },
  "nonceDomains": [
    { "id": "owner-intent", "consumer": "vault-contract", "persistence": "on-chain-atomic" },
    { "id": "risk-permit", "consumer": "vault-contract", "persistence": "on-chain-atomic" },
    { "id": "strategy-decision", "consumer": "risk-service", "persistence": "durable-transactional" },
    {
      "id": "vault-state-version",
      "consumer": "vault-contract",
      "persistence": "on-chain-atomic-exact-match-and-increment"
    }
  ],
  "signatures": [
    {
      "id": "owner-execution-intent",
      "scheme": "EIP-712",
      "signerRole": "owner",
      "consumer": "vault-contract",
      "implemented": false,
      "trackedBy": "TRUST-001",
      "requiredBindings": [
        "chainId",
        "verifyingContract",
        "vault",
        "owner",
        "asset",
        "target",
        "selector",
        "calldataHash",
        "value",
        "amountIn",
        "minimumAmountOut",
        "expectedVaultStateVersion",
        "vaultStateHash",
        "nonce",
        "deadline",
        "policyHash"
      ]
    },
    {
      "id": "risk-execution-permit",
      "scheme": "EIP-712",
      "signerRole": "risk-signer",
      "consumer": "vault-contract",
      "implemented": false,
      "trackedBy": "TRUST-001",
      "requiredBindings": [
        "chainId",
        "verifyingContract",
        "vault",
        "owner",
        "asset",
        "target",
        "selector",
        "calldataHash",
        "value",
        "amountIn",
        "minimumAmountOut",
        "expectedVaultStateVersion",
        "vaultStateHash",
        "ownerIntentHash",
        "decisionCommitment",
        "accountSnapshotCommitment",
        "nonce",
        "deadline",
        "policyHash"
      ]
    },
    {
      "id": "strategy-decision",
      "scheme": "Ed25519-canonical-json",
      "signerRole": "strategy-runtime",
      "consumer": "risk-service",
      "implemented": false,
      "trackedBy": "TRUST-001",
      "requiredBindings": [
        "decisionId",
        "strategyFamilyId",
        "strategyVersionId",
        "codeMeasurement",
        "policyHash",
        "accountSnapshotCommitment",
        "targetIntentHash",
        "nonce",
        "issuedAt",
        "expiresAt"
      ]
    },
    {
      "id": "account-snapshot",
      "scheme": "Ed25519-canonical-json",
      "signerRole": "snapshot-signer",
      "consumer": "risk-service",
      "implemented": false,
      "trackedBy": "TRUST-001",
      "requiredBindings": [
        "snapshotId",
        "chainId",
        "vault",
        "owner",
        "blockNumber",
        "blockHash",
        "vaultStateVersion",
        "vaultStateHash",
        "capturedAt",
        "balancesCommitment",
        "positionsCommitment"
      ]
    }
  ],
  "secrets": [
    {
      "id": "owner-private-key",
      "holder": "user-wallet",
      "allowedStorage": ["user-wallet-only"],
      "forbiddenStorage": ["repository", "server", "plaintext-env", "browser-storage", "logs", "ci"]
    },
    {
      "id": "strategy-runtime-private-key",
      "holder": "isolated-strategy-runtime",
      "allowedStorage": ["runtime-key-provider"],
      "forbiddenStorage": [
        "repository",
        "server-filesystem",
        "plaintext-env",
        "browser-storage",
        "logs",
        "ci"
      ]
    },
    {
      "id": "risk-signer-private-key",
      "holder": "isolated-risk-signer",
      "allowedStorage": ["hardware-or-managed-key-provider"],
      "forbiddenStorage": [
        "repository",
        "server-filesystem",
        "plaintext-env",
        "browser-storage",
        "logs",
        "ci"
      ]
    },
    {
      "id": "snapshot-signer-private-key",
      "holder": "isolated-snapshot-signer",
      "allowedStorage": ["managed-key-provider"],
      "forbiddenStorage": [
        "repository",
        "server-filesystem",
        "plaintext-env",
        "browser-storage",
        "logs",
        "ci"
      ]
    },
    {
      "id": "deployer-private-key",
      "holder": "one-time-low-balance-deployer",
      "allowedStorage": ["hardware-wallet-or-managed-key-provider"],
      "forbiddenStorage": [
        "repository",
        "server-filesystem",
        "plaintext-env",
        "browser-storage",
        "logs",
        "ci"
      ]
    },
    {
      "id": "pause-guardian-private-key",
      "holder": "separate-guardian-wallet",
      "allowedStorage": ["hardware-wallet-or-managed-key-provider"],
      "forbiddenStorage": [
        "repository",
        "server-filesystem",
        "plaintext-env",
        "browser-storage",
        "logs",
        "ci"
      ]
    }
  ],
  "trustBoundaries": [
    {
      "id": "TB-01",
      "from": "web-ui",
      "to": "user-wallet",
      "data": ["transaction-request", "human-readable-eip712"],
      "controls": [
        "explicit-chain-address-amount-deadline-display",
        "one-intent-one-confirmation",
        "wallet-native-review"
      ]
    },
    {
      "id": "TB-02",
      "from": "strategy-runtime",
      "to": "risk-service",
      "data": ["signed-strategy-decision"],
      "controls": ["pinned-release-key", "policy-hash", "decision-expiry", "durable-decision-nonce"]
    },
    {
      "id": "TB-03",
      "from": "confirmed-chain-state",
      "to": "snapshot-signer",
      "data": ["vault-state", "block-number", "block-hash"],
      "controls": ["chain-id-check", "confirmation-policy", "signed-snapshot-commitment"]
    },
    {
      "id": "TB-04",
      "from": "risk-service",
      "to": "user-wallet-or-permissionless-relayer",
      "data": ["risk-execution-permit", "owner-execution-intent"],
      "controls": [
        "dual-signature",
        "full-call-binding",
        "independent-nonce",
        "expected-vault-state-version",
        "short-deadline"
      ]
    },
    {
      "id": "TB-05",
      "from": "user-wallet-or-permissionless-relayer",
      "to": "vault-contract",
      "data": ["signed-transaction", "dual-signed-execution"],
      "controls": [
        "msg-sender-is-not-authorization",
        "contract-revalidation",
        "atomic-nonce-consumption",
        "exact-state-version-and-hash",
        "typed-call",
        "fixed-target-selector"
      ]
    },
    {
      "id": "TB-06",
      "from": "rpc-provider",
      "to": "adapter-and-indexer",
      "data": ["chain-id", "bytecode", "receipt", "logs", "block-hash"],
      "controls": ["untrusted-rpc", "runtime-hash-check", "bounded-retry", "reorg-rollback"]
    },
    {
      "id": "TB-07",
      "from": "vault-contract",
      "to": "fixed-token-or-venue",
      "data": ["erc20-transfer", "typed-allowlisted-call"],
      "controls": [
        "non-proxy-target",
        "exact-approval",
        "balance-delta-equality",
        "return-value-check",
        "reentrancy-guard"
      ]
    },
    {
      "id": "TB-08",
      "from": "confirmed-chain-events",
      "to": "application-view",
      "data": ["confirmed-state", "confirmation-level", "reorg-status"],
      "controls": [
        "pending-not-success",
        "event-identity",
        "block-hash-checkpoint",
        "contract-state-reconciliation"
      ]
    },
    {
      "id": "TB-09",
      "from": "deployment-and-release-manifest",
      "to": "web-adapter-risk-service",
      "data": ["trusted-addresses", "runtime-hashes", "abi-hash", "release-key", "policy-hash"],
      "controls": [
        "compile-time-pinned-expected-digest",
        "no-runtime-or-request-selection",
        "content-addressed-manifest",
        "build-provenance",
        "clean-rebuild",
        "cross-component-hash-check"
      ]
    },
    {
      "id": "TB-10",
      "from": "local-browser",
      "to": "local-demo-http-server",
      "data": ["session-cookie", "origin", "simulation-command"],
      "controls": [
        "loopback-only-listener",
        "origin-and-csrf-enforcement",
        "http-only-session",
        "local-simulation-isolation",
        "no-testnet-adapter-import"
      ]
    }
  ],
  "trustBootstrap": {
    "mode": "reviewed-manifest-digest-compiled-into-web-and-risk-service-releases",
    "currentManifestDigest": null,
    "runtimeOrRequestSelectionAllowed": false,
    "requiredConsumers": ["web-release", "risk-service-release"],
    "mismatchPolicy": "fail-closed-disable-all-testnet-writes",
    "rotation": "new-independent-review-new-release-and-adr-required",
    "walletDisplay": "chain-contract-addresses-and-manifest-digest-required",
    "activationTask": "TRUST-001"
  },
  "prohibited": [
    "mainnet-or-unknown-network",
    "real-value-assets",
    "unattended-or-autonomous-trading",
    "application-custody-of-user-keys",
    "automatic-hidden-or-batch-wallet-signing",
    "arbitrary-target-calldata-or-delegatecall",
    "native-asset-custody-or-nonzero-call-value",
    "proxy-upgrade-path",
    "non-owner-withdrawal-or-arbitrary-recipient-transfer",
    "unlimited-token-approval",
    "caller-supplied-trust-root",
    "runtime-or-request-selected-manifest-digest",
    "in-memory-only-replay-protection",
    "pending-transaction-presented-as-success",
    "local-simulation-role-promotion-reaching-testnet",
    "async-external-custody-or-pending-position",
    "admin-mint-confiscate-blacklist-or-burn-from-vault",
    "admin-bulk-migration-or-silent-address-replacement",
    "privileged-or-identity-bound-relayer"
  ]
}
