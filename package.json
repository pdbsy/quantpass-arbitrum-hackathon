{
  "name": "quantpass-robinhood-chain-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "test": "node --test test/security-model.test.ts test/engineering.test.ts test/robinhood-chain.test.ts test/governance.test.mjs test/supply-chain.test.mjs test/threat-model.test.mjs test/planning.test.mjs test/domain.test.ts test/server.test.ts test/http-e2e.test.ts test/web-messages.test.ts",
    "typecheck": "tsc --noEmit && tsc --project apps/web/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,yml,yaml}\"",
    "secrets:check": "node tools/check-secrets.mjs",
    "config:check": "node tools/check-config.ts",
    "robinhood:check": "node --env-file=.env.example tools/check-robinhood-chain.ts",
    "governance:build": "node tools/check-governance-v2.mjs --write",
    "governance:check": "node tools/check-governance-v2.mjs",
    "supply:build": "node tools/check-supply-chain.mjs --write",
    "supply:check": "node tools/check-supply-chain.mjs",
    "threats:build": "node tools/check-threat-model.mjs --write",
    "threats:check": "node tools/check-threat-model.mjs",
    "planning:build": "node tools/build-planning.mjs",
    "planning:check": "node tools/build-planning.mjs --check",
    "build": "npm run planning:check && npm run build:web",
    "build:web": "vite build apps/web --config apps/web/vite.config.ts",
    "demo": "npm run build:web && node --env-file=.env.example apps/server/src/main.ts",
    "demo:backup": "node --env-file=.env.example tools/backup-demo.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run secrets:check && npm run robinhood:check && npm run governance:check && npm run supply:check && npm run threats:check && npm run planning:check && npm run build:web",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.10.0",
    "globals": "17.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
